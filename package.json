{
  "name": "dsh-browser-scope",
  "version": "0.11.0-alpha.1",
  "description": "Agent-native browser DevTools workbench with session-scoped controller arbitration for DeepSeek Harness",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "browser",
    "devtools",
    "playwright",
    "debugging",
    "agent"
  ],
  "homepage": "https://github.com/HakureiMonika/dsh-browser-scope#readme",
  "bugs": {
    "url": "https://github.com/HakureiMonika/dsh-browser-scope/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HakureiMonika/dsh-browser-scope.git"
  },
  "author": {
    "name": "HakureiMonika",
    "email": "107752645+HakureiMonika@users.noreply.github.com",
    "url": "https://github.com/HakureiMonika"
  },
  "type": "module",
  "main": "lib/index.mjs",
  "types": "lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:rc8": "npm run typecheck",
    "typecheck:alpha1": "tsc --noEmit -p tsconfig.alpha1.json",
    "typecheck:all": "npm run typecheck:alpha1 && npm run typecheck:rc8",
    "build": "npm run typecheck && tsdown",
    "build:release": "npm run typecheck:all && tsdown",
    "test:public": "node --experimental-strip-types tests/chromium-manager.ts && node --experimental-strip-types tests/context-identity.ts && node --experimental-strip-types tests/context-adapter.ts && node --experimental-strip-types tests/input-trace.ts && node --experimental-strip-types tests/flight-recorder.ts && node --experimental-strip-types tests/l3-privacy-performance.ts && node --experimental-strip-types tests/surface-evidence.ts && node --experimental-strip-types tests/build-registry.ts && node --experimental-strip-types tests/application-registry.ts && node --experimental-strip-types tests/browser-controller.ts && node --experimental-strip-types tests/l3-closure.ts && node --experimental-strip-types tests/diagnostic-core.ts",
    "test": "npm run test:public",
    "test:full": "npm run test:public && node tests/session-controller-integration.mjs && node tests/integration.mjs && node tests/final-hygiene.mjs",
    "test:chromium": "node --experimental-strip-types tests/chromium-manager.ts"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.8 <0.1.0 || >=0.1.1-rc.1 <0.1.1 || >=0.1.2-alpha.1 <0.1.2",
    "@deepseek-ai/dsh-attachment": ">=0.1.0-rc.8 <0.1.0 || >=0.1.1-rc.1 <0.1.1 || >=0.1.2-alpha.1 <0.1.2",
    "@deepseek-ai/dsh-client-connection": ">=0.1.0-rc.8 <0.1.0 || >=0.1.1-rc.1 <0.1.1 || >=0.1.2-alpha.1 <0.1.2",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.0-rc.8 <0.1.0 || >=0.1.1-rc.1 <0.1.1 || >=0.1.2-alpha.1 <0.1.2",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.1.0-rc.8 <0.1.0 || >=0.1.1-rc.1 <0.1.1 || >=0.1.2-alpha.1 <0.1.2",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.0-rc.8 <0.1.0 || >=0.1.1-rc.1 <0.1.1 || >=0.1.2-alpha.1 <0.1.2",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.8 <0.1.0 || >=0.1.1-rc.1 <0.1.1 || >=0.1.2-alpha.1 <0.1.2",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.8 <0.1.0 || >=0.1.1-rc.1 <0.1.1 || >=0.1.2-alpha.1 <0.1.2",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.8 <0.1.0 || >=0.1.1-rc.1 <0.1.1 || >=0.1.2-alpha.1 <0.1.2",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.8 <0.1.0 || >=0.1.1-rc.1 <0.1.1 || >=0.1.2-alpha.1 <0.1.2",
    "@deepseek-ai/schemastery": ">=3.18.1 <4",
    "react": "^18.2.0"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "0.3.31",
    "playwright-core": "1.61.1",
    "yauzl-promise": "4.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.8",
    "@deepseek-ai/dsh-attachment": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-connection": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.8",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.8",
    "@deepseek-ai/dsh-session": "0.1.0-rc.8",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.8",
    "@deepseek-ai/schemastery": "3.18.1",
    "@types/node": "22.20.0",
    "@types/react": "18.3.31",
    "lightningcss": "1.32.0",
    "react": "18.3.1",
    "tsdown": "0.22.2",
    "typescript": "6.0.3"
  },
  "license": "MIT"
}
